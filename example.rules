# Snort / Suricata example rules (reference only)
# Rule: detect suspicious outbound manifest upload attempt (example)
# ALERT when HTTP POST contains 'audit-manifest.json' filename in payload
alert http any any -> any any (msg:"AI-Validator - audit-manifest upload detected"; \
   content:"audit-manifest.json"; http_client_body; sid:1000001; rev:1; classtype:policy-violation;)

# Rule: detect base64-encoded pickle indicators in HTTP body (heuristic)
alert http any any -> any any (msg:"AI-Validator - possible pickle payload (base64, 'c__' pattern)"; \
   content:"Y3B"; content:"c__"; http_client_body; pcre:"/c__reduce__|c__getstate__/"; sid:1000002; rev:1; classtype:misc-activity;)