# ISO-UNC-AI Compliance Snort Rules
# AI System Validator — network-layer detection

alert tcp any any -> any 443 (msg:"ISO-UNC-AI: Unencrypted AI telemetry channel"; sid:1000001; rev:1;)
alert tcp any any -> any 8080 (msg:"ISO-UNC-AI: Non-standard AI service port"; sid:1000002; rev:1;)
alert tcp any any -> any 53 (msg:"ISO-UNC-AI: DNS exfiltration pattern detected"; sid:1000003; rev:1;)
